# Set these in your hosting dashboard (or export them before `npm start`). All are optional.
PORT=3000
# Folder for the SQLite database. It MUST be on persistent storage in production.
DATA_DIR=./data
# Long random string used to sign member QR codes. Generated and stored automatically if unset.
APP_SECRET=
# First-run staff accounts (only used when no staff accounts exist yet)
OWNER_EMAIL=owner@emarewards.app
OWNER_PASSWORD=EmaOwner2026!
MANAGER_EMAIL=manager@emarewards.app
MANAGER_PASSWORD=EmaManager2026!
EMPLOYEE_EMAIL=staff@emarewards.app
EMPLOYEE_PASSWORD=EmaStaff2026!
# Load labeled demonstration members/transactions on first start (true/false)
SEED_DEMO=true
